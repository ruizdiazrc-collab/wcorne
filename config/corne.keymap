#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// Generado desde crkbd.layout.json (VIA)

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp TAB    &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P      &kp BSPC
&kp LSHFT  &kp A      &kp S      &kp D      &kp F      &kp G      &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp RET
&kp LCTRL  &kp Z      &kp X      &kp C      &kp V      &kp B      &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp RSHFT
                                 &kp LALT   &kp RGUI   &mo 1      &kp SPACE  &kp RALT   &kp DEL
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
&kp TAB        &none          &none          &none          &kp LS(N2)     &kp LS(SQT)    &kp N7         &kp N8         &kp N9         &kp KP_PLUS    &kp KP_MINUS   &kp DEL
&kp LSHFT      &none          &none          &none          &kp LS(N8)     &kp LS(N9)     &kp N4         &kp N5         &kp N6         &kp N0         &kp UP         &kp KP_DIVIDE
&kp LCTRL      &none          &none          &none          &kp LS(MINUS)  &kp LS(N1)     &kp N1         &kp N2         &kp N3         &kp LEFT       &kp DOWN       &kp RIGHT
                                             &kp LGUI       &trans         &kp RET        &kp SPACE      &mo 3          &kp RALT
            >;
        };

        numpad_layer {
            display-name = "Numpad";
            bindings = <
&kp C_PP         &kp C_PREV       &kp C_NEXT       &kp C_MUTE       &kp C_VOL_DN     &kp C_VOL_UP     &kp KP_N7        &kp KP_N8        &kp KP_N9        &kp KP_PLUS      &kp KP_MINUS     &kp KP_MULTIPLY
&kp LSHFT        &none            &none            &none            &kp LS(N8)       &kp LS(N9)       &kp KP_N4        &kp KP_N5        &kp KP_N6        &kp KP_N0        &kp UP           &kp KP_DIVIDE
&kp LCTRL        &none            &none            &kp NON_US_BSLH  &kp LS(MINUS)    &kp LS(N1)       &kp KP_N1        &kp KP_N2        &kp KP_N3        &kp LEFT         &kp DOWN         &kp RIGHT
                                                   &kp LGUI         &mo 3            &kp RET          &kp SPACE        &trans           &kp RALT
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
&bt BT_CLR      &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &kp LS(N0)      &kp LS(SQT)     &kp LS(BSLH)    &none           &none           &none
&studio_unlock  &none           &none           &none           &none           &none           &kp LS(N2)      &kp SQT         &kp BSLH        &none           &none           &none
&bootloader     &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none
                                                &kp LGUI        &trans          &kp RET         &kp SPACE       &trans          &kp RALT
            >;
        };
    };
};
